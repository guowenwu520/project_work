# -------------------------
# External model bundle
# -------------------------
# Do not upload FBX/OBJ/GLB/textures in ModelBundles.
/ModelBundles/*

# Lightweight manifest/instructions may still be committed.
!/ModelBundles/prop_manifest.json
!/ModelBundles/README.md
!/ModelBundles/.gitkeep

# Optional alternative external model locations.
/ExternalModels/
/ModelsExternal/
/DownloadedModels/

